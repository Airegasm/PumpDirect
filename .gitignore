# Owner-uploaded trigger assets (Lottie JSON + sound files dropped via the
# editor's upload buttons). Keep directories alive via .gitkeep but exclude
# the user's personal content.
public/assets/triggers/lottie/*
!public/assets/triggers/lottie/.gitkeep
public/assets/triggers/sound/*
!public/assets/triggers/sound/.gitkeep
public/assets/triggers/video/*
!public/assets/triggers/video/.gitkeep

